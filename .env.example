# Leave empty to use same-origin /api/* (recommended for Vercel deployment
# where the FastAPI function lives in /api/index.py).
#
# Set this when running the API and web on different hosts (e.g. local dev
# with uvicorn on :8000 while next dev runs on :3000):
#
# NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=
